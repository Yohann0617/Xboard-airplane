# ============================================
# 阶段 1: 构建阶段 - 安装依赖
# ============================================
FROM phpswoole/swoole:php8.1-alpine AS builder

# 复制 PHP 扩展安装器
COPY --from=mlocati/php-extension-installer /usr/bin/install-php-extensions /usr/local/bin/

# 安装构建所需的依赖
RUN set -eux; \
    install-php-extensions pcntl bcmath inotify zip; \
    apk --no-cache add git patch; \
    rm -rf /tmp/* /var/cache/apk/*

# 设置工作目录
WORKDIR /www

# 设置 Composer 环境变量
ENV COMPOSER_ALLOW_SUPERUSER=1 \
    COMPOSER_MEMORY_LIMIT=-1

# 复制 composer 文件和 patches
COPY composer.json composer.lock* /www/
COPY patches /www/patches/

# 配置并安装 Composer 依赖
RUN set -eux; \
    composer config --no-plugins allow-plugins.cweagans/composer-patches true; \
    composer config audit.block-insecure false; \
    composer install \
        --optimize-autoloader \
        --no-dev \
        --no-interaction \
        --prefer-dist \
        --ignore-platform-reqs \
        --no-scripts \
        --no-autoloader; \
    rm -rf /root/.composer/cache

# 复制所有项目文件
COPY . /www

# 生成优化的 autoloader
RUN composer dump-autoload --optimize --no-dev --classmap-authoritative

# 清理不需要的文件
RUN set -eux; \
    rm -rf \
        /www/.git \
        /www/.github \
        /www/tests \
        /www/.editorconfig \
        /www/.gitignore \
        /www/.gitattributes \
        /www/phpunit.xml \
        /www/README.md \
        /www/docker-compose.sample.yaml

# ============================================
# 阶段 2: 运行阶段 - 最小化镜像
# ============================================
FROM phpswoole/swoole:php8.1-alpine

# 安装运行时依赖（不包括 git、patch 等构建工具）
RUN set -eux; \
    apk --no-cache add \
        shadow \
        supervisor \
        nginx \
        sqlite \
        nginx-mod-http-brotli \
        mysql-client \
        tzdata; \
    addgroup -S -g 1000 www; \
    adduser -S -G www -u 1000 www; \
    rm -rf /tmp/* /var/cache/apk/*

# 复制 PHP 扩展安装器并安装必要的扩展
COPY --from=mlocati/php-extension-installer /usr/bin/install-php-extensions /usr/local/bin/
RUN set -eux; \
    install-php-extensions pcntl bcmath inotify zip; \
    rm /usr/local/bin/install-php-extensions; \
    rm -rf /tmp/*

# 设置工作目录
WORKDIR /www

# 设置环境变量
ENV COMPOSER_ALLOW_SUPERUSER=1 \
    TZ=Asia/Shanghai

# 从构建阶段复制配置文件
COPY --from=builder --chown=www:www /.docker /
COPY --from=builder --chown=www:www /www /www

# 执行必要的 Laravel 命令并设置权限
RUN set -eux; \
    php artisan package:discover --ansi || true; \
    php artisan storage:link 2>/dev/null || true; \
    if [ -f /www/.env.example ]; then cp -f /www/.env.example /www/.env; fi; \
    chown -R www:www /www; \
    chmod -R 775 /www/storage /www/bootstrap/cache; \
    find /www -type f -exec chmod 664 {} \; 2>/dev/null || true; \
    find /www -type d -exec chmod 775 {} \; 2>/dev/null || true

# 健康检查
HEALTHCHECK --interval=30s --timeout=3s --start-period=40s --retries=3 \
    CMD php artisan --version || exit 1

# 暴露端口
EXPOSE 80 443

# 使用 supervisor 启动服务
CMD ["/usr/bin/supervisord", "--nodaemon", "-c", "/etc/supervisor/supervisord.conf"]
